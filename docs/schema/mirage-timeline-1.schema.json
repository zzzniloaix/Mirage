{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mirage timeline document, schema version 1",
  "description": "The events of one ladder report's timeline on its reference's frames and the attributions of its drops, as mirage_vmaf timeline writes them (docs/TIMELINE_FORMAT.md; DECISIONS.md D-072): the ladder part, and the session part of a scripted session, its plan, its spans and its own events, whose payloads it types (D-068, D-104, D-105, D-108); a ladder alone has session_plan null and sessions empty. It uses only type, enum, const, required, properties, additionalProperties, items, allOf, if and then, which the subset validator of tests/test_timeline_doc.cpp checks. Every field written from a double is typed number, since a whole double is written as an integer literal.",
  "type": "object",
  "required": [
    "schema", "schema_version", "tool", "command", "ffmpeg_libraries", "options", "config_file",
    "ladder_report", "session_plan", "axis", "variants", "sessions", "timeline", "detection",
    "overlap", "attributions", "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "enum": ["mirage-timeline"] },
    "schema_version": { "enum": [1] },
    "tool": { "type": "string" },
    "command": { "type": "string" },
    "ffmpeg_libraries": {
      "description": "Each FFmpeg library's version at run time, by name, as the ladder report lists its own (DECISIONS.md P-035).",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "options": {
      "description": "Every option of the build, with its value.",
      "type": "object"
    },
    "config_file": {
      "description": "The config file the options were read from, by its path as given and the SHA-256 of its bytes; null without one.",
      "type": ["object", "null"],
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "ladder_report": {
      "description": "The ladder report the document was built from: its path, the SHA-256 of its bytes and of its scores digest, and its provenance as the report gives it.",
      "type": "object",
      "required": [
        "path", "sha256", "scores_sha256", "status", "reference_mode", "model", "model_source",
        "model_sha256", "scaler", "libvmaf_version", "libvmaf_package_version", "master"
      ],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "scores_sha256": { "type": "string" },
        "status": { "type": "string" },
        "reference_mode": { "type": "string" },
        "model": { "type": "string" },
        "model_source": { "type": "string" },
        "model_sha256": { "type": ["string", "null"] },
        "scaler": { "type": "string" },
        "libvmaf_version": { "type": "string" },
        "libvmaf_package_version": { "type": "string" },
        "master": {
          "type": "object",
          "required": ["url", "location", "sha256"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string" },
            "location": { "type": "string" },
            "sha256": { "type": "string" }
          }
        }
      }
    },
    "session_plan": {
      "description": "The plan of the build's scripted session, by its path as given and the SHA-256 of its bytes (DECISIONS.md D-105 (a)); null for a ladder alone, which has no session.",
      "type": ["object", "null"],
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "axis": {
      "description": "What events are placed on, the reference's frames, and the seconds offsets are printed in (DECISIONS.md D-073), with the check of the two clocks.",
      "type": "object",
      "required": [
        "kind", "seconds", "frame_duration", "frames", "reference", "checked", "tick_den", "ticks",
        "keys", "runs", "warnings"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["reference-frames"] },
        "seconds": { "enum": ["playlist-time", "frame-grid"] },
        "frame_duration": { "type": "string" },
        "frames": { "type": "integer" },
        "reference": {
          "type": "object",
          "required": ["url", "time_base", "frame_rate", "sequences"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string" },
            "time_base": { "type": "string" },
            "frame_rate": { "type": "string" },
            "sequences": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["first_index", "first_pts", "first_pts_ticks", "frames"],
                "additionalProperties": false,
                "properties": {
                  "first_index": { "type": "integer" },
                  "first_pts": { "type": ["number", "null"] },
                  "first_pts_ticks": { "type": ["integer", "null"] },
                  "frames": { "type": "integer" }
                }
              }
            }
          }
        },
        "checked": { "enum": ["segment-map", "report-only"] },
        "tick_den": { "type": "integer" },
        "ticks": {
          "description": "Each reference frame's seconds in ticks of 1/tick_den s, as stretches of frames (DECISIONS.md D-092 (a), D-099 (a)): frame first + k of a stretch is at the tick first_tick + scale * floor((phase + k * num) / den), where step is the rational \"num/den\" in lowest terms with a positive denominator, phase an integer from 0 to den - 1 and scale an integer from 1, the number of ticks to one tick of the clock the frames follow, 1 for a plain stretch.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["first", "frames", "first_tick", "step", "phase", "scale"],
            "additionalProperties": false,
            "properties": {
              "first": { "type": "integer" },
              "frames": { "type": "integer" },
              "first_tick": { "type": "integer" },
              "step": { "type": "string" },
              "phase": { "type": "integer" },
              "scale": { "type": "integer" }
            }
          }
        },
        "keys": {
          "description": "Each reference frame's media key, its sequence and its PTS in ticks of the reference's time base, as stretches of frames of one sequence (DECISIONS.md D-092 (a), D-099 (a)): frame first + k has the PTS first_pts_ticks + scale * floor((phase + k * num) / den), by the rule of ticks, or every frame's PTS is unknown, with first_pts_ticks null, step \"0/1\", phase 0 and scale 1.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["first", "frames", "sequence", "first_pts_ticks", "step", "phase", "scale"],
            "additionalProperties": false,
            "properties": {
              "first": { "type": "integer" },
              "frames": { "type": "integer" },
              "sequence": { "type": "integer" },
              "first_pts_ticks": { "type": ["integer", "null"] },
              "step": { "type": "string" },
              "phase": { "type": "integer" },
              "scale": { "type": "integer" }
            }
          }
        },
        "runs": {
          "description": "Every run of frames the check found more than half a frame off: warnings, and the facts of a playlist without a segment map.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["test", "sequence", "first", "last", "frames", "largest_at", "largest", "warning"],
            "additionalProperties": false,
            "properties": {
              "test": { "enum": ["clocks", "playlist-grid", "report-grid"] },
              "sequence": { "type": "integer" },
              "first": { "type": "integer" },
              "last": { "type": "integer" },
              "frames": { "type": "integer" },
              "largest_at": { "type": "integer" },
              "largest": { "type": "number" },
              "warning": { "type": "boolean" }
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "variants": {
      "description": "Each scored playlist, the reference's and each pair's distorted one, with the master entries naming it and both of its BANDWIDTH ranks (DECISIONS.md D-075).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "role", "pair", "entries", "url", "bandwidth", "resolution", "codecs",
          "rank_from_top", "rank_from_bottom", "playlist", "segment_map"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer" },
          "role": { "enum": ["reference", "distorted"] },
          "pair": { "type": ["integer", "null"] },
          "entries": { "type": "array", "items": { "type": "integer" } },
          "url": { "type": "string" },
          "bandwidth": { "type": ["integer", "null"] },
          "resolution": { "type": ["string", "null"] },
          "codecs": { "type": ["string", "null"] },
          "rank_from_top": { "type": ["integer", "null"] },
          "rank_from_bottom": { "type": ["integer", "null"] },
          "playlist": {
            "description": "The media playlist as the build read it again, its location and sha256 not both empty; null for a variant not read from a playlist (DECISIONS.md D-092 (c)).",
            "type": ["object", "null"],
            "required": ["url", "location", "sha256"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string" },
              "location": { "type": "string" },
              "sha256": { "type": "string" }
            }
          },
          "segment_map": {
            "description": "\"ok\", or \"refused: \" and why (DECISIONS.md D-081 (c)), for a variant read from a playlist; null for one that wasn't, which has no segment map (DECISIONS.md D-092 (c)).",
            "type": ["string", "null"]
          }
        }
      }
    },
    "sessions": {
      "description": "The build's scripted session, one at most (DECISIONS.md D-072), there exactly when session_plan is; none for a ladder alone. An event's session and a session's curve name it by its place here.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "wallclock_anchor_utc", "spans"],
        "additionalProperties": false,
        "properties": {
          "id": { "description": "What --curve session:<id> names it by: its place among the sessions as text, a form pending the owner (docs/TIMELINE_FORMAT.md).", "type": "string" },
          "name": { "description": "Its plan's name, which may be empty.", "type": "string" },
          "wallclock_anchor_utc": {
            "description": "The UTC time its fetch started, from which its requests' wall clocks count, RFC 3339 to the microsecond with the zone Z, YYYY-MM-DDTHH:MM:SS.ffffffZ; null when its files weren't fetched (DECISIONS.md D-073, D-108 (c)).",
            "type": ["string", "null"]
          },
          "spans": {
            "description": "Its spans in play order, one at least, each starting where the one before it ended (DECISIONS.md D-105 (a)).",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["variant", "entry", "first_seq", "last_seq", "ref_index", "ref_end", "scored"],
              "additionalProperties": false,
              "properties": {
                "variant": { "description": "The variant it plays, by its id.", "type": "integer" },
                "entry": { "description": "The plan's master entry, one of the variant's.", "type": "integer" },
                "first_seq": { "type": "integer" },
                "last_seq": { "type": "integer" },
                "ref_index": { "type": "integer" },
                "ref_end": { "description": "Exclusive: where its last segment's span ends.", "type": "integer" },
                "scored": { "description": "False where it plays the reference in top-rung mode, which has no score (DECISIONS.md D-105 (b)).", "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "timeline": {
      "description": "Every event, once, in canonical order: a point at a reference frame or a span of reference frames, half-open.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "source", "type", "variant", "session", "segment", "ref_index", "ref_end", "t",
          "t_end", "seq", "pts", "pts_ticks", "wallclock", "payload"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "source": { "enum": ["vmaf", "network", "playlist", "scte35", "player", "decoder"] },
          "type": {
            "enum": [
              "context_start", "unpaired_frame",
              "segment_request", "playlist_request",
              "segment", "discontinuity", "program_date_time", "daterange", "tag", "period",
              "cue_out", "cue_out_cont", "cue_in", "ad_break", "splice_point", "message", "cancel",
              "variant_span", "variant_switch",
              "keyframe", "corrupt_packet", "decode_error"
            ]
          },
          "variant": { "type": ["integer", "null"] },
          "session": { "type": ["integer", "null"] },
          "segment": { "type": ["integer", "null"] },
          "ref_index": { "type": "integer" },
          "ref_end": { "type": ["integer", "null"] },
          "t": { "type": "number" },
          "t_end": { "type": ["number", "null"] },
          "seq": { "type": "integer" },
          "pts": { "type": ["number", "null"] },
          "pts_ticks": { "type": ["integer", "null"] },
          "wallclock": { "type": ["number", "null"] },
          "payload": { "type": "object" }
        },
        "allOf": [
          {
            "description": "A request of a session's fetch, one per fetched file, a redirected one included (DECISIONS.md D-104 (a)): of its session, with its wall clock, seconds from the session's start (D-073), and the payload src/SessionPlan.h gives it, as the owner kept it (D-108 (c)), its times seconds from the session's start, null where a row didn't reach them.",
            "if": { "required": ["source"], "properties": { "source": { "const": "network" } } },
            "then": {
              "properties": {
                "session": { "type": "integer" },
                "wallclock": { "type": "number" },
                "payload": {
                  "type": "object",
                  "required": [
                    "url", "range", "status", "status_text", "bytes", "start", "first_byte", "end", "duration",
                    "failed", "error", "origin", "chain"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "url": { "description": "As fetched: the report's, or the same path on --fetch-base's server.", "type": "string" },
                    "range": {
                      "description": "The segment's EXT-X-BYTERANGE, all that was read of its file; null for the whole file.",
                      "type": ["object", "null"],
                      "required": ["offset", "length"],
                      "additionalProperties": false,
                      "properties": {
                        "offset": { "type": "integer" },
                        "length": { "type": "integer" }
                      }
                    },
                    "status": { "description": "The last row's HTTP status; null without one.", "type": ["integer", "null"] },
                    "status_text": { "type": ["string", "null"] },
                    "bytes": { "description": "The last row's body bytes; null when unknown.", "type": ["integer", "null"] },
                    "start": { "description": "The first row's start, its open's, connection included.", "type": ["number", "null"] },
                    "first_byte": { "description": "When the last row's status line came.", "type": ["number", "null"] },
                    "end": { "description": "The last row's end.", "type": ["number", "null"] },
                    "duration": { "description": "end minus start.", "type": ["number", "null"] },
                    "failed": { "type": "boolean" },
                    "error": { "description": "The fetch's own failure, or null.", "type": ["string", "null"] },
                    "origin": { "const": "fetch" },
                    "chain": {
                      "description": "Each row the network logger made of the file's fetch, in order: one per request, a redirect's included.",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "url", "start", "sent", "first_byte", "end", "status", "status_text", "bytes",
                          "content_length", "failed", "error"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "url": { "type": "string" },
                          "start": { "type": ["number", "null"] },
                          "sent": { "type": ["number", "null"] },
                          "first_byte": { "type": ["number", "null"] },
                          "end": { "type": ["number", "null"] },
                          "status": { "type": ["integer", "null"] },
                          "status_text": { "type": ["string", "null"] },
                          "bytes": { "type": ["integer", "null"] },
                          "content_length": { "type": ["integer", "null"] },
                          "failed": { "type": "boolean" },
                          "error": { "type": ["string", "null"] }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "description": "A span of a session, over the reference frames of its segments, with the rung it plays by its master entry, URI, BANDWIDTH, RESOLUTION and both ranks (DECISIONS.md D-075), its plan's segments, and whether it is scored (D-105 (b)).",
            "if": { "required": ["type"], "properties": { "type": { "const": "variant_span" } } },
            "then": {
              "properties": {
                "session": { "type": "integer" },
                "payload": {
                  "type": "object",
                  "required": [
                    "entry", "uri", "bandwidth", "resolution", "rank_from_top", "rank_from_bottom", "first_seq",
                    "last_seq", "scored"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "entry": { "type": "integer" },
                    "uri": { "type": ["string", "null"] },
                    "bandwidth": { "type": ["integer", "null"] },
                    "resolution": { "type": ["string", "null"] },
                    "rank_from_top": { "type": ["integer", "null"] },
                    "rank_from_bottom": { "type": ["integer", "null"] },
                    "first_seq": { "type": "integer" },
                    "last_seq": { "type": "integer" },
                    "scored": { "type": "boolean" }
                  }
                }
              }
            }
          },
          {
            "description": "A session's switch, at the first frame of a span whose entry isn't the one before it (DECISIONS.md D-108 (b)), on the variant played from it, from the rung of the span before to the rung of the span it starts, each by its master entry, URI, BANDWIDTH, RESOLUTION and both ranks (D-075), as its plan scripts it.",
            "if": { "required": ["type"], "properties": { "type": { "const": "variant_switch" } } },
            "then": {
              "properties": {
                "session": { "type": "integer" },
                "payload": {
                  "type": "object",
                  "required": ["from", "to", "origin"],
                  "additionalProperties": false,
                  "properties": {
                    "from": {
                      "type": "object",
                      "required": ["entry", "uri", "bandwidth", "resolution", "rank_from_top", "rank_from_bottom"],
                      "additionalProperties": false,
                      "properties": {
                        "entry": { "type": "integer" },
                        "uri": { "type": ["string", "null"] },
                        "bandwidth": { "type": ["integer", "null"] },
                        "resolution": { "type": ["string", "null"] },
                        "rank_from_top": { "type": ["integer", "null"] },
                        "rank_from_bottom": { "type": ["integer", "null"] }
                      }
                    },
                    "to": {
                      "type": "object",
                      "required": ["entry", "uri", "bandwidth", "resolution", "rank_from_top", "rank_from_bottom"],
                      "additionalProperties": false,
                      "properties": {
                        "entry": { "type": "integer" },
                        "uri": { "type": ["string", "null"] },
                        "bandwidth": { "type": ["integer", "null"] },
                        "resolution": { "type": ["string", "null"] },
                        "rank_from_top": { "type": ["integer", "null"] },
                        "rank_from_bottom": { "type": ["integer", "null"] }
                      }
                    },
                    "origin": { "const": "plan" }
                  }
                }
              }
            }
          },
          {
            "description": "An offline event is of no session, whose own events are of the network and player sources (DECISIONS.md D-068), and has no wall clock (D-073).",
            "if": { "required": ["source"], "properties": { "source": { "enum": ["vmaf", "playlist", "scte35", "decoder"] } } },
            "then": { "properties": { "session": { "type": "null" }, "wallclock": { "type": "null" } } }
          }
        ]
      }
    },
    "detection": {
      "description": "The parameters detection ran with and the curves it ran on (DECISIONS.md D-077); null when no detection ran.",
      "type": ["object", "null"],
      "required": [
        "threshold", "window", "min_points", "baseline", "warm_up", "context_first", "curves",
        "session_rules"
      ],
      "additionalProperties": false,
      "properties": {
        "threshold": { "type": "number" },
        "window": { "type": "integer" },
        "min_points": { "type": "integer" },
        "baseline": { "enum": ["median-non-low"] },
        "warm_up": { "type": "integer" },
        "context_first": { "enum": ["no-special-case"] },
        "curves": {
          "description": "The curves detection ran on: a pair's by its pair's number (DECISIONS.md D-092 (b)), a session's by its place in sessions.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "index"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["pair", "session"] },
              "index": { "type": "integer" }
            }
          }
        },
        "session_rules": {
          "description": "The rules by which a session's drops are its pairs' drops clipped to the spans that played them (DECISIONS.md D-077; design section 6.3), where detection ran on a session's curve; null where it ran on no session's. This form, an object of five named rules, is pending the owner (docs/TIMELINE_FORMAT.md).",
          "type": ["object", "null"],
          "required": ["drops", "pieces", "at_switch", "baseline", "spans_of_one_variant"],
          "additionalProperties": false,
          "properties": {
            "drops": { "enum": ["pair-drops-clipped-to-spans"] },
            "pieces": { "enum": ["more-than-min-points"] },
            "at_switch": { "enum": ["two-drops"] },
            "baseline": { "enum": ["pair-drop"] },
            "spans_of_one_variant": { "enum": ["one-stretch"] }
          }
        }
      }
    },
    "overlap": {
      "description": "Which events an attribution lists (DECISIONS.md D-078).",
      "type": "object",
      "required": ["rule", "margin_before", "margin_after", "scope"],
      "additionalProperties": false,
      "properties": {
        "rule": { "enum": ["half-open"] },
        "margin_before": { "type": "string" },
        "margin_after": { "type": "string" },
        "scope": { "enum": ["curve-inputs"] }
      }
    },
    "attributions": {
      "description": "Each detected drop of a curve (detected true; none when detection is null), or an interval a user gave (detected false), which mirage_vmaf timeline never writes, with the events of the curve's own inputs that meet it, grouped by source in the order of the sources, each event named by its id.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "curve", "detected", "interval", "baseline", "min", "mean", "drop_magnitude", "mean_drop",
          "overlapping_events"
        ],
        "additionalProperties": false,
        "properties": {
          "curve": {
            "description": "A pair's curve by its pair's number (DECISIONS.md D-092 (b)), or a session's by its place in sessions.",
            "type": "object",
            "required": ["kind", "index"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["pair", "session"] },
              "index": { "type": "integer" }
            }
          },
          "detected": { "type": "boolean" },
          "interval": {
            "type": "object",
            "required": ["ref_index", "ref_end", "t", "t_end", "points"],
            "additionalProperties": false,
            "properties": {
              "ref_index": { "type": "integer" },
              "ref_end": { "type": "integer" },
              "t": { "type": "number" },
              "t_end": { "type": "number" },
              "points": { "type": "integer" }
            }
          },
          "baseline": { "type": ["number", "null"] },
          "min": { "type": ["number", "null"] },
          "mean": { "type": ["number", "null"] },
          "drop_magnitude": { "type": ["number", "null"] },
          "mean_drop": { "type": ["number", "null"] },
          "overlapping_events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "events"],
              "additionalProperties": false,
              "properties": {
                "source": { "enum": ["vmaf", "network", "playlist", "scte35", "player", "decoder"] },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["event", "offset", "offset_end", "offset_frames", "offset_end_frames"],
                    "additionalProperties": false,
                    "properties": {
                      "event": { "type": "string" },
                      "offset": { "type": "number" },
